# ─────────────────────────────────────────────────────────────────────────────
# R4R 2026 — environment
#
# Copy to .env.local for development. On Vercel these go in
# Project Settings → Environment Variables.
#
# .env.local must be in .gitignore. Committed secrets in a public repo is the
# most common way college projects get burned — and GitHub emailing you about
# it is a bad way to find out.
#
# Only NEXT_PUBLIC_* variables reach the browser. Everything else is
# server-only. Never prefix a secret with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# BYPASSES ALL ROW LEVEL SECURITY. Server-only, never NEXT_PUBLIC_.
# If this leaks, every policy in 0003_rls.sql is void.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Ticket QR signing ───────────────────────────────────────────────────────
# Generate:  openssl rand -hex 32
# Changing this invalidates every ticket already issued — set it once, before
# registration opens, and leave it alone.
TICKET_SIGNING_SECRET=

# ── Razorpay ────────────────────────────────────────────────────────────────
# Leave blank until KYC clears. The app runs on the manual UPI path meanwhile:
# set settings.payment_mode = 'manual_upi' in the database.
# Test keys work today — you can build and test the whole flow before approval.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend ──────────────────────────────────────────────────────────────────
# NOTE: login OTPs do NOT use this key. They go through Supabase Auth, which
# you point at Resend over SMTP (see BACKEND_SETUP.md step 4).
# This key is only for the few emails the app sends itself.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Rush4Rush <noreply@rush4rush.com>"

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.in
